{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://w3id.org/snf-glossary/schema/term.schema.json",
  "title": "Spent fuel dissolution glossary term",
  "type": "object",
  "required": ["id", "term", "category", "status", "definition", "authors", "created", "updated"],
  "additionalProperties": false,
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"},
    "date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "text": {"type": ["string", "null"]},
    "lang": {"type": "string", "pattern": "^[a-z]{2}$"}
  },
  "properties": {
    "id": {"$ref": "#/$defs/id"},
    "term": {"type": "string", "minLength": 1},
    "abbreviation": {"$ref": "#/$defs/text"},
    "symbol": {"$ref": "#/$defs/text"},
    "category": {"type": "string", "pattern": "^[a-z0-9-]+(/[a-z0-9-]+)*$"},
    "tags": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "status": {"enum": ["draft", "review", "approved", "deprecated"]},
    "replaced_by": {"$ref": "#/$defs/text"},

    "definition": {"type": "string", "minLength": 1},
    "description": {"$ref": "#/$defs/text"},
    "notes": {"type": "array", "items": {"type": "string"}},
    "pitfalls": {"type": "array", "items": {"type": "string"}},

    "synonyms": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["label", "type"],
        "additionalProperties": false,
        "properties": {
          "label": {"type": "string", "minLength": 1},
          "type": {"enum": ["exact", "abbreviation", "spelling-variant", "deprecated", "narrower-usage", "broader-usage"]},
          "lang": {"$ref": "#/$defs/lang"},
          "note": {"$ref": "#/$defs/text"}
        }
      }
    },
    "translations": {
      "type": ["object", "null"],
      "propertyNames": {"pattern": "^[a-z]{2}$"},
      "additionalProperties": {"type": ["string", "null"]}
    },

    "quantity": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "kind": {"enum": ["", "numeric", "categorical", "text", "boolean", "date", null]},
        "unit": {"$ref": "#/$defs/text"},
        "si_unit": {"$ref": "#/$defs/text"},
        "other_units": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["unit"],
            "additionalProperties": false,
            "properties": {"unit": {"type": "string"}, "to_db_unit": {"$ref": "#/$defs/text"}}
          }
        },
        "allowed_values": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["value"],
            "additionalProperties": false,
            "properties": {"value": {"type": "string"}, "definition": {"$ref": "#/$defs/text"}}
          }
        },
        "typical_range": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "properties": {
            "min": {"type": ["number", "null"]},
            "max": {"type": ["number", "null"]},
            "context": {"$ref": "#/$defs/text"},
            "reference": {"$ref": "#/$defs/text"}
          }
        },
        "formula": {"$ref": "#/$defs/text"},
        "formula_variables": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["symbol", "meaning"],
            "additionalProperties": false,
            "properties": {"symbol": {"type": "string"}, "meaning": {"type": "string"}, "unit": {"$ref": "#/$defs/text"}}
          }
        }
      }
    },

    "broader": {"type": "array", "items": {"$ref": "#/$defs/id"}, "uniqueItems": true},
    "narrower": {"type": "array", "items": {"$ref": "#/$defs/id"}, "uniqueItems": true},
    "related": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id"],
        "additionalProperties": false,
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "relation": {"enum": ["related", "depends-on", "measured-by", "input-of", "result-of", "opposite-of", "see-also"]}
        }
      }
    },

    "db_mapping": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["table", "field"],
        "additionalProperties": false,
        "properties": {
          "table": {"type": "string", "minLength": 1},
          "field": {"type": "string", "minLength": 1},
          "excel_header": {"$ref": "#/$defs/text"},
          "note": {"$ref": "#/$defs/text"}
        }
      }
    },

    "references": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "citation"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "type": {"enum": ["article", "report", "book", "standard", "thesis", "website", "database", "other"]},
          "citation": {"type": "string", "minLength": 1},
          "doi": {"anyOf": [{"type": "null"}, {"const": ""}, {"type": "string", "pattern": "^10\\.\\S+/\\S+$"}]},
          "url": {"$ref": "#/$defs/text"},
          "pages": {"$ref": "#/$defs/text"},
          "quote": {"$ref": "#/$defs/text"},
          "supports": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "standards": {"type": "array", "items": {"type": "string"}},
    "external_ids": {"type": ["object", "null"], "additionalProperties": {"type": ["string", "null"]}},

    "examples": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["text"],
        "additionalProperties": false,
        "properties": {"text": {"type": "string"}, "reference": {"$ref": "#/$defs/text"}}
      }
    },

    "authors": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
    "reviewers": {"type": "array", "items": {"type": "string"}},
    "created": {"$ref": "#/$defs/date"},
    "updated": {"$ref": "#/$defs/date"},
    "history": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["date", "change"],
        "additionalProperties": false,
        "properties": {"date": {"$ref": "#/$defs/date"}, "author": {"$ref": "#/$defs/text"}, "change": {"type": "string"}}
      }
    }
  }
}
